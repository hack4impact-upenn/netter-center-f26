# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# D1 Database
D1_DATABASE_ID=

# Box user OAuth — see src/integrations/box/README.md
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:3001/api/box/oauth/callback
# Generate 32 random bytes in standard base64; keep out of source control
BOX_TOKEN_ENCRYPTION_KEY=

# R2 Storage
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email (Resend) — optional, for sending notifications
RESEND_API_KEY=

# LLM (OpenRouter)
OPENROUTER_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Intake - X (Twitter) API
X_BEARER_TOKEN=
