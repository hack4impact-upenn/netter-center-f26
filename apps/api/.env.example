# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# D1 Database
D1_DATABASE_ID=

# R2 Storage
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email (Resend) — notifications. See src/integrations/email/README.md
RESEND_API_KEY=
# Sender, e.g. "Netter Center <notifications@yourdomain.org>" (needs a verified domain)
EMAIL_FROM=
# Comma-separated staff emails allowed to use the notifications dashboard
ADMIN_EMAILS=
# Default file naming rule, e.g. {lastname}_{firstname}_{document}.pdf
FILE_NAME_FORMAT=

# LLM (OpenRouter)
OPENROUTER_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Intake - X (Twitter) API
X_BEARER_TOKEN=
